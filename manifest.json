{
  "manifest_version": 3,
  "name": "ULAB Faculty Companion",
  "version": "1.6.0",
  "description": "Student Advising (CSE/BBA/English/MSJ/EEE/Bangla), Bulk Save, Capstone Eligibility (CSE) for ULAB faculty on URMS",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://urms-awp.ulab.edu.bd/*"],
  "externally_connectable": {
    "matches": [
      "https://mms.ulab.edu.bd/*",
      "http://localhost:3000/*",
      "https://ulab-mms.netlify.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://urms-awp.ulab.edu.bd/RMS_ggs_result/ResultEntryFromExcel*",
        "https://urms-awp.ulab.edu.bd/RMS_ggs_result/LoadExcel*"
      ],
      "js": ["features/mms-import/urms-import-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://urms-awp.ulab.edu.bd/RMS_ggs_result/ResultEntryFromExcel*",
        "https://urms-awp.ulab.edu.bd/RMS_ggs_result/LoadExcel*",
        "https://urms-awp.ulab.edu.bd/RMS_ggs_result/LoadStudentFromExcel*"
      ],
      "js": ["features/mms-grades/urms-grade-fill-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://urms-awp.ulab.edu.bd/StudentRegistration*"],
      "js": [
        "features/time/time.js",
        "features/advising/catalogue-factory.js",
        "features/advising/catalogues/cse.js",
        "features/advising/catalogues/bba.js",
        "features/advising/catalogues/english.js",
        "features/advising/catalogues/msj.js",
        "features/advising/catalogues/eee.js",
        "features/advising/catalogues/bangla.js",
        "features/advising/catalogues/registry.js",
        "features/advising/advising.js",
        "features/advising/student-page-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ULAB Faculty Companion"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  }
}
